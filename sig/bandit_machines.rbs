module BanditMachines
  VERSION: String
  ARM_CAPACITY: Integer
  TICKET_CAPACITY: Integer

  type tie_break = :lowest_index | :highest_index | :least_tried | :draw
  type reason = :cold_start | :explore | :exploit | :upper_bound
  # Every symbol that means "this call was not honoured and changed nothing":
  # one per variant of the core's `Refusal`. Each method below lists exactly
  # the ones it can answer.
  type refusal = :unknown_arm | :no_open_arm | :tickets_full | :exhausted | :stale_ticket | :unknown_ticket
               | :reward_out_of_range | :saturated

  # `0 < max_reward`, `prior <= max_reward`, both in 0..2**32-1; anything else
  # raises TypeError or RangeError, an unknown tie_break ArgumentError.
  class Config < Data
    attr_reader max_reward: Integer
    attr_reader prior: Integer
    attr_reader tie_break: tie_break
    def self.new: (Integer max_reward, Integer prior, tie_break tie_break) -> Config
                | (max_reward: Integer, prior: Integer, tie_break: tie_break) -> Config
  end

  # `numerator <= denominator`, `denominator > 0`, both in 0..2**32-1.
  class Ratio < Data
    ZERO: Ratio
    ONE: Ratio
    attr_reader numerator: Integer
    attr_reader denominator: Integer
    def self.new: (Integer numerator, Integer denominator) -> Ratio
                | (numerator: Integer, denominator: Integer) -> Ratio
  end

  # Two uniform draws, each in 0..2**64-1.
  class Draws < Data
    attr_reader gate: Integer
    attr_reader pick: Integer
    def self.new: (Integer gate, Integer pick) -> Draws
                | (gate: Integer, pick: Integer) -> Draws
  end

  # Mirrors the core's `Ticket`. Opaque; it cannot be built or copied by hand.
  # Only the bandit that issued it honours it.
  class Ticket
    def arm: () -> Integer
    def generation: () -> Integer
    # The scoped id: the issuing bandit's scope in the top 16 bits, the
    # position in its selection order (from one) in the low 48.
    def serial: () -> Integer
    # The scope of the bandit that issued it, 0..65535.
    def scope: () -> Integer
  end

  class Selection < Data
    attr_reader ticket: Ticket
    attr_reader reason: reason
    def self.new: (Ticket ticket, reason reason) -> Selection
                | (ticket: Ticket, reason: reason) -> Selection
    def arm: () -> Integer
  end

  class ArmStats < Data
    attr_reader open: bool
    attr_reader generation: Integer
    attr_reader rewarded: Integer
    attr_reader reward_sum: Integer
    attr_reader pending: Integer
    def self.new: (bool open, Integer generation, Integer rewarded, Integer reward_sum, Integer pending) -> ArmStats
                | (open: bool, generation: Integer, rewarded: Integer, reward_sum: Integer, pending: Integer) -> ArmStats
    def tries: () -> Integer
  end

  # The core's `math` module: unsigned Q8.56 fixed point, integers in and out.
  module Math
    FRACTION_BITS: Integer
    ONE: Integer
    def self.log2_q56: (Integer value) -> Integer
    def self.ln_q56: (Integer value) -> Integer
    def self.bonus_q56: (Integer total, Integer tries) -> Integer
    def self.mean_q56: (Integer sum, Integer count, Integer range) -> Integer
  end

  # An arm index is any Integer in 0..2**64-1. One that names no arm
  # (ARM_CAPACITY or above) is answered, not raised: :unknown_arm from the
  # mutating methods, nil from `stats` and `ucb1_index_q56`.
  class Bandit
    # Scope zero.
    def self.new: (Config config) -> Bandit
    # `scope` is an Integer in 0..65535: TypeError otherwise, RangeError
    # outside the range.
    def self.with_scope: (Config config, Integer scope) -> Bandit
    # Continues `scope` after a restart from a saved `issued` count. Restores
    # only the serial sequence: every arm is closed and nothing is outstanding.
    # RangeError when `issued` is above 2**48 - 1.
    def self.resumed: (Config config, Integer scope, Integer issued) -> Bandit
    def config: () -> Config
    # The scope carried by every Ticket this bandit issues.
    def scope: () -> Integer
    # Serials issued in this scope so far: the count to save for `resumed`.
    def issued: () -> Integer
    def outstanding: () -> Integer
    # nil once every serial of the scope has been issued.
    def next_serial: () -> Integer?
    def stats: (Integer arm) -> ArmStats?
    # Honoured: :opened, or the repeat :already_open. Refused: :unknown_arm.
    def open: (Integer arm) -> (:opened | :already_open | :unknown_arm)
    # Honoured: :closed, or the repeat :already_closed. Refused: :unknown_arm.
    def close: (Integer arm) -> (:closed | :already_closed | :unknown_arm)
    # Honoured: a Selection. Refused: :no_open_arm, :tickets_full, :exhausted.
    def select_ucb1: (Integer pick) -> (Selection | :no_open_arm | :tickets_full | :exhausted)
    def select_epsilon_greedy: (Ratio epsilon, Draws draws) -> (Selection | :no_open_arm | :tickets_full | :exhausted)
    # nil for an unknown, closed or cold arm.
    def ucb1_index_q56: (Integer arm) -> Integer?
    # Honoured: :rewarded. Refused: :stale_ticket, :unknown_ticket (a Ticket
    # from a bandit in another scope included), :reward_out_of_range,
    # :saturated.
    def reward: (Ticket ticket, Integer reward) -> (:rewarded | :stale_ticket | :unknown_ticket | :reward_out_of_range | :saturated)
    # Honoured: :abandoned. Refused: :stale_ticket, :unknown_ticket.
    def abandon: (Ticket ticket) -> (:abandoned | :stale_ticket | :unknown_ticket)
    # Honoured: the number of tickets revoked. Refused: :unknown_ticket, for a
    # serial of another scope.
    def revoke_before: (Integer serial) -> (Integer | :unknown_ticket)
    # The number of tickets revoked: every outstanding one. Never refuses;
    # arm statistics and generations are kept.
    def revoke_all: () -> Integer
    # Honoured: the number of tickets voided. Refused: :unknown_arm, :exhausted.
    def reset: (Integer arm) -> (Integer | :unknown_arm | :exhausted)
    # Honoured: the number of tickets voided. Refused: :exhausted.
    def reset_all: () -> (Integer | :exhausted)
    # Honoured: :decayed. Refused: :unknown_arm.
    def decay: (Integer arm, Ratio keep) -> (:decayed | :unknown_arm)
    # Always honoured.
    def decay_all: (Ratio keep) -> :decayed
    def arm_capacity: () -> Integer
    def ticket_capacity: () -> Integer
  end
end
